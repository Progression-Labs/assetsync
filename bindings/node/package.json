{
  "name": "@progression-labs/assetsync",
  "version": "0.1.0",
  "description": "Content-addressed asset sync: a sha256 lock file, verified downloads from R2 or HTTP, a local hardlinked cache. Node-API bindings to the assetsync crate. Proprietary, Progression Labs.",
  "keywords": [
    "assets",
    "content-addressed",
    "lockfile",
    "napi-rs",
    "r2",
    "sync"
  ],
  "license": "UNLICENSED",
  "author": "Progression Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Progression-Labs/assetsync.git",
    "directory": "bindings/node"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "os": [
    "linux",
    "darwin"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "bun test",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  },
  "napi": {
    "binaryName": "assetsync",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
